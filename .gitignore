# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Keep lockfiles ignored by default.
Cargo.lock
# Track the workspace lockfile used by CI `--locked` checks.
!/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Added by cargo
/target

# IntelliJ IDEA
*.idea

# Visual Studio Code
*.vscode

# venv: Python virtual environment
venv/
.venv/

# macOS
.DS_Store

# Env files
*.env

# SQLite test database file:
test.db

# Local scripts
scripts/

# Code coverage
codecov.json